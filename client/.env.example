# Backend API base URL (no trailing slash).
# Leave empty to use relative URLs (works with Vite proxy in dev).
# Set this to your deployed backend URL for production builds, e.g.:
# VITE_API_BASE_URL=https://your-backend.railway.app
VITE_API_BASE_URL=

# WebSocket URL for the authority dashboard.
# Leave empty to auto-derive from VITE_API_BASE_URL.
# VITE_WS_URL=wss://your-backend.railway.app/ws
VITE_WS_URL=
